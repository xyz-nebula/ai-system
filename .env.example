# Скопируйте в .env и заполните. .env не коммитить.

# Секрет, общий с Backend (заголовок Authorization: Bearer ...). Например: openssl rand -hex 32
ARENA_SERVICE_TOKEN=

# Адрес, на котором сервис слушает порт 8000: приватный IP сервера, доступный Backend.
ARENA_BIND_IP=127.0.0.1

# OpenAI-совместимый сервер модели (LocalAI, vLLM и т. п.).
# host.docker.internal — эта же машина; иначе укажите адрес сервера.
ARENA_QWEN_CHAT_URL=http://host.docker.internal:8080/v1/chat/completions
# Имя модели на сервере. Проверено на Qwen3 8-9B (в LocalAI: qwen3.8-9b-q4).
ARENA_QWEN_MODEL=qwen3.8-9b-q4
# Параметры вызова ниже рассчитаны на LocalAI (metadata отключает thinking у Qwen3).
ARENA_QWEN_TIMEOUT_SECONDS=180
ARENA_QWEN_FAST_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false},"temperature":0}'
ARENA_QWEN_REASONED_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false},"temperature":0}'
ARENA_QWEN_JUDGE_EXTRA_BODY='{"metadata":{"enable_thinking":"false"}}'
ARENA_MODEL_MAX_ATTEMPTS=2
ARENA_RETRIEVAL_TIMEOUT_SECONDS=30

# /v2/evaluate: soft — без модельных проверок, цитаты чинятся по транскрипту; strict — все проверки.
ARENA_EVALUATE_VALIDATION=soft
