# uv run --env-file .env loads this configuration. Demo needs no external services.
ARENA_MODEL_MODE=demo
ARENA_SERVICE_TOKEN=

# Set ARENA_MODEL_MODE=qwen and choose URLs/model available in your environment.
ARENA_QWEN_CHAT_URL=http://localhost:8080/v1/chat/completions
ARENA_QWEN_MODEL=qwen3.8-9b-q4
ARENA_QWEN_JSON_MODE=prompt
ARENA_QWEN_TIMEOUT_SECONDS=180
ARENA_QWEN_READINESS_TIMEOUT_SECONDS=5
ARENA_QWEN_TLS_VERIFY=true
ARENA_QWEN_API_KEY=
ARENA_QWEN_FAST_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false},"temperature":0}'
ARENA_QWEN_REASONED_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false},"temperature":0}'
# LocalAI per-request switch, only for v2 judge generation; other stages remain unchanged.
ARENA_QWEN_JUDGE_EXTRA_BODY='{"metadata":{"enable_thinking":"false"}}'
# soft: /v2/evaluate без модельных проверок, цитаты чинятся по транскрипту; strict: все проверки.
ARENA_EVALUATE_VALIDATION=soft
ARENA_MODEL_MAX_ATTEMPTS=2

ARENA_QDRANT_URL=http://127.0.0.1:6333
ARENA_EMBEDDINGS_URL=http://127.0.0.1:8081
ARENA_JUDGE_COLLECTION=arena_judge_methodology_v1
ARENA_RETRIEVAL_TIMEOUT_SECONDS=30
